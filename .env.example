# Copy to .env and fill in. Never commit .env.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# PORT=3001
# DULO_CLIENT_ORIGIN=http://localhost:5173

# Where conversations are stored. Unset = sessions/ under the working directory.
# A second harness started for testing MUST set this to a throwaway directory:
# PORT alone does not isolate data, so two instances started from the same
# checkout otherwise share one sessions/ folder — and cleaning up after the
# test instance then deletes the real one's conversations.
# DULO_SESSIONS_DIR=/tmp/dulo-scratch-sessions

# Where the agent puts the projects it builds (and its .dulo/ briefs).
# Unset = workspace/ under the checkout. Every file tool is confined to it.
# DULO_WORKSPACE_DIR=/tmp/dulo-scratch-workspace

# Use a different config file than dulo.config.json in the checkout.
# DULO_CONFIG=/tmp/dulo-scratch.config.json

# Bounds on one model request. A provider that accepts the connection and then
# sends nothing used to hang a turn until someone cancelled it. Milliseconds.
# LLM_STALL_MS=90000   # longest silence before the first byte or between chunks
# LLM_TOTAL_MS=600000  # longest a single request may live

# Secrets for MCP servers go here, never in dulo.config.json: src/mcp.ts passes
# the harness's own environment to every server it starts.
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
